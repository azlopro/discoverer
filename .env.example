# scrap-metal worker — copy to .env and fill in.
#
# Scan tunables (timeouts, body limit, concurrency, user-agent) and
# dedup come from the server with each chunk; they are NOT worker
# config. To change them, edit the job on the server side.

# Required
WORKER_ID=eu-1
WORKER_API_KEY=worker-eu-1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SERVER_URL=https://hello.azlo.pro

# Optional
WORKER_SPOOL_DIR=./spool
WORKER_HEARTBEAT=60s
WORKER_IDLE_POLL=10s

# gzip /results POST bodies. Server transparently decodes them.
WORKER_COMPRESS=true

# Re-try the spool dir on this cadence so a transient network outage
# doesn't strand results until the next process restart. 0 disables
# (replay then runs only at startup).
WORKER_SPOOL_REPLAY=5m
